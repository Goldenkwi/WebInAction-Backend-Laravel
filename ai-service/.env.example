# ============================================================================
# Konfigurasi AI Microservice
# ============================================================================
# Salin file ini jadi .env lalu sesuaikan.

# --- Model ---
# Path relatif ke folder ai-service/
MODEL_PATH_CATEGORY=./models/category
MODEL_PATH_PRIORITY=./models/priority

# --- Tokenizer ---
# Panjang maksimum input (token). Angka ini dari statistik panjang teks dataset.
# PENTING: tokenizer_config.json model punya model_max_length sentinel,
# jadi max_length WAJIB di-set eksplisit.
MAX_LEN_CATEGORY=256
MAX_LEN_PRIORITY=128

# --- Server ---
HOST=127.0.0.1
PORT=8100

# --- Keamanan ---
# Kosongkan kalau service hanya diakses dari jaringan internal (disarankan).
# Kalau diisi, request wajib mengirim header: X-Service-Token: <nilai>
SERVICE_TOKEN=

# --- Perilaku ---
# true = kalau salah satu model gagal dimuat, service tetap jalan dengan model
# yang berhasil (graceful degradation).
FAIL_SOFT=true
